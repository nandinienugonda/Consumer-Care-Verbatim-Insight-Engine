# --- Database ---
# Host port docker compose publishes Postgres on. Use another port (e.g. 5433) if a native
# Postgres already listens on 5432, and keep DATABASE_URL's port in sync.
DB_HOST_PORT=5432
DATABASE_URL=postgresql://ccvie:ccvie@localhost:5432/ccvie
# Optional read replica for the query path; defaults to DATABASE_URL.
DATABASE_READ_URL=
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Local development: AUTH_DEV_MODE=true and a random AUTH_DEV_SECRET of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mint a token with: python backend/scripts/dev_token.py --help
# Production: AUTH_DEV_MODE=false and AUTH_JWKS_URL pointing at the identity provider.
AUTH_DEV_MODE=true
AUTH_DEV_SECRET=
AUTH_ISSUER=ccvie-dev
AUTH_AUDIENCE=ccvie-api
AUTH_JWKS_URL=
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Embeddings (Layer 1) ---
# EMBEDDING_DIMENSION must match both the model output and vector() in db/migrations.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM (Layer 3) — change the provider or model here, nowhere else ---
LLM_PROVIDER=anthropic
LLM_MODEL_NAME=

# --- Router thresholds (Layer 2, see ADR-0001) ---
ROUTER_ENTITY_COUNT_THRESHOLD=3
ROUTER_WORD_COUNT_LOW=50
ROUTER_WORD_COUNT_HIGH=150
ROUTER_TAXONOMY_COVERAGE_HIGH=0.80
ROUTER_TAXONOMY_COVERAGE_LOW=0.40

# --- Ingestion cadence (see ADR-0003) ---
INGESTION_CADENCE_MINUTES=60

# --- Observability ---
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=ccvie-api
# e.g. http://localhost:4318 ; empty disables trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Eval / CI gate thresholds (Layer 5) ---
EVAL_LEAD_TIME_REGRESSION_MAX_DAYS_DROP=1
EVAL_CITATION_ACCURACY_MIN=0.95
EVAL_ROUTER_ACCURACY_MIN=0.85

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
